DATABASE_URL="postgresql://plants:plants@localhost:5433/axildb?schema=public"
NEXT_PUBLIC_APP_URL="https://app.axildb.com"
NEXT_PUBLIC_MARKETING_URL="https://axildb.com"
NEXT_PUBLIC_GITHUB_URL="https://github.com/wetlabs-dev/AxilDB"
NEXT_PUBLIC_DONATE_URL="https://ko-fi.com/wetlabs"
PORT=3000

# Used to encrypt authenticator app secrets at rest. Generate a long random value
# for production, for example: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=""

# Outbound email. Use SMTP so AxilDB can run with SES, Gmail Workspace, Postmark,
# Mailgun, self-hosted mail, or another provider.
EMAIL_DELIVERY_MODE="log"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="AxilDB <no-reply@axildb.com>"
SMTP_REPLY_TO=""
REMINDER_WORKER_INTERVAL_SECONDS="300"

# Optional OpenAI integration for drafting plant definition descriptions,
# taxonomy metadata, aliases, and plant husbandry guide drafts.
# Keep this server-side only; never expose it with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=""
OPENAI_DESCRIPTION_MODEL="gpt-5.4-mini"
OPENAI_DESCRIPTION_HOURLY_LIMIT="20"
OPENAI_MAGIC_FILL_MODEL="gpt-5.4-mini"
OPENAI_MAGIC_FILL_HOURLY_LIMIT="10"
OPENAI_HUSBANDRY_FILL_MODEL="gpt-5.4-mini"
OPENAI_HUSBANDRY_FILL_HOURLY_LIMIT="10"

# Documentation generation. These are used only when running the optional
# `docs` Docker Compose profile or local documentation scripts.
AXILDB_DOCS_BASE_URL="https://app.axildb.com"
AXILDB_DOCS_COLLECTION_SLUG="axildb"
AXILDB_DOCS_EMAIL="docs@axildb.com"
AXILDB_DOCS_PASSWORD=""
AXILDB_DOCS_SKIP_LOGIN="0"
