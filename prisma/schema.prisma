model PlantDefinition {
  id                         String   @id @default(cuid())
  collectionId               String?
  genus                      String
  species                    String
  hybridNotation             String?
  cultivarName               String?
  authority                  String?
  cultivarRegistrationNumber String?
  governingBodyId            String?
  confidence                 String   @default("UNCERTAIN")
  acquisitionLabel           String?
  provisionalTaxon           String?
  wikipediaUrl               String?
  inaturalistUrl             String?
  powoUrl                    String?
  gbifUrl                    String?
  description                String?
  notes                      String?
  isValidated                Boolean  @default(false)
  validatedAt                DateTime?
  validatedByUserId          String?
  validatedSourceCollectionId String?
  validatedSourceDefinitionId String?
  validatedPlantDefinitionId String?
  validationNotes            String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  collection    Collection?      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  governingBody GoverningBody?  @relation(fields: [governingBodyId], references: [id], onDelete: SetNull)
  validatedBy   User?           @relation("PlantDefinitionValidatedBy", fields: [validatedByUserId], references: [id], onDelete: SetNull)
  validatedSourceCollection Collection? @relation("ValidatedPlantDefinitionSourceCollection", fields: [validatedSourceCollectionId], references: [id], onDelete: SetNull)
  validatedPlantDefinition PlantDefinition? @relation("LocalValidatedDefinitionLink", fields: [validatedPlantDefinitionId], references: [id], onDelete: SetNull)
  localLinkedDefinitions PlantDefinition[] @relation("LocalValidatedDefinitionLink")
  instances     PlantInstance[]
  aliases       PlantAlias[]
  husbandryGuide PlantHusbandryGuide?
  husbandrySourceFor PlantHusbandryGuide[] @relation("HusbandrySourceDefinition")
  outgoingDefinitionShareRequests PlantDefinitionShareRequest[] @relation("SourceDefinitionShareRequests")
  incomingDefinitionShareRequests PlantDefinitionShareRequest[] @relation("TargetDefinitionShareRequests")
  validationCandidates PlantDefinitionValidationCandidate[] @relation("ValidationCandidateSourceDefinition")
  approvedValidationCandidates PlantDefinitionValidationCandidate[] @relation("ValidationCandidateApprovedDefinition")
  disputes PlantDefinitionDispute[] @relation("ValidatedDefinitionDisputes")
  validatedChanges ValidatedDefinitionChange[]
  matchedIdentificationLogs PlantIdentificationLog[] @relation("PlantIdentificationLogMatchedDefinition")
  appliedIdentificationLogs PlantIdentificationLog[] @relation("PlantIdentificationLogAppliedDefinition")
  createdIdentificationLogs PlantIdentificationLog[] @relation("PlantIdentificationLogCreatedDefinition")

  @@index([collectionId])
  @@index([governingBodyId])
  @@index([confidence])
  @@index([isValidated])
  @@index([validatedByUserId])
  @@index([validatedSourceCollectionId])
  @@index([validatedSourceDefinitionId])
  @@index([validatedPlantDefinitionId])
}

model ValidatedDefinitionChange {
  id                    String   @id @default(cuid())
  validatedDefinitionId String
  changedByUserId       String?
  changedAt             DateTime @default(now())
  changeSummary         String
  changedFieldsJson     Json
  previousValuesJson    Json?
  nextValuesJson        Json?
  createdAt             DateTime @default(now())

  validatedDefinition PlantDefinition @relation(fields: [validatedDefinitionId], references: [id], onDelete: Cascade)
  changedByUser       User?           @relation("ValidatedDefinitionChangeActor", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([validatedDefinitionId])
  @@index([changedByUserId])
  @@index([changedAt])
}

model CollectionUpdateDigestDelivery {
