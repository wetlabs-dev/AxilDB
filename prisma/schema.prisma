  submittedByUser          User?           @relation("PlantDefinitionDisputeSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedByUser           User?           @relation("PlantDefinitionDisputeReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([validatedPlantDefinitionId])
  @@index([submittedByUserId])
  @@index([reviewedByUserId])
  @@index([reason])
  @@index([status])
}

