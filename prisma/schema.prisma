  @@unique([collectionId, userId, targetType, targetId])
  @@index([collectionId, targetType, targetId])
  @@index([userId])
  @@index([createdAt])
}

model PushSubscription {
  id           String    @id @default(cuid())
  userId       String
  endpoint     String    @unique
  p256dh       String
  auth         String
  userAgent    String?
  deviceLabel  String?
