  @@index([sortOrder])
}

model WorkflowRun {
  id                String    @id @default(cuid())
  collectionId      String
  templateId        String?
  title             String
  status            String    @default("ACTIVE")
  scopeType         String    @default("COLLECTION")
  locationId        String?
  assignedToUserId  String?
  startedByUserId   String
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  cancelledAt       DateTime?
  summary           String?
  triggerType       String?
  triggerConfigJson Json?
  isTriggerEnabled  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  collection Collection        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  template   WorkflowTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  location   Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignedTo User?             @relation("WorkflowRunAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  startedBy  User              @relation("WorkflowRunStartedBy", fields: [startedByUserId], references: [id], onDelete: Cascade)
  plants     WorkflowRunPlant[]
  steps      WorkflowRunStep[]

  @@index([collectionId])
  @@index([templateId])
  @@index([status])
  @@index([scopeType])
  @@index([locationId])
  @@index([assignedToUserId])
  @@index([startedByUserId])
  @@index([startedAt])
  @@index([triggerType])
  @@index([isTriggerEnabled])
}

model WorkflowRunPlant {
  id              String @id @default(cuid())
  collectionId    String
  runId           String
  plantInstanceId String

  collection    Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  run           WorkflowRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  plantInstance PlantInstance @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)

  @@unique([runId, plantInstanceId])
  @@index([collectionId])
  @@index([runId])
  @@index([plantInstanceId])
}

model WorkflowRunStep {
  id                String    @id @default(cuid())
  collectionId      String
  runId             String
  templateStepId    String?
  stepType          String
  title             String
  instructions      String?
  required          Boolean   @default(true)
  sortOrder         Int       @default(0)
  configJson        Json?
  status            String    @default("PENDING")
  completedByUserId String?
  completedAt       DateTime?
  notes             String?
  outputJson        Json?
  createdRecordType String?
  createdRecordId   String?

  collection      Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  run             WorkflowRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  templateStep    WorkflowStep? @relation(fields: [templateStepId], references: [id], onDelete: SetNull)
  completedByUser User?         @relation("WorkflowRunStepCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([runId])
  @@index([templateStepId])
  @@index([stepType])
  @@index([status])
  @@index([sortOrder])
  @@index([completedByUserId])
  @@index([createdRecordType, createdRecordId])
}

model Reminder {
  id          String    @id @default(cuid())
  collectionId String?
  userId      String
  title       String
  body        String?
  category    String    @default("GENERAL")
  entityType  String?
  entityId    String?
  dueAt       DateTime
  rrule       String?
  lastSentAt  DateTime?
  nextSendAt  DateTime?
  completedAt DateTime?
  pausedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  collection Collection?        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries ReminderDelivery[]
  careSheetTasks CareSheetTask[]

  @@index([collectionId])
  @@index([userId])
  @@index([category])
  @@index([entityType, entityId])
  @@index([nextSendAt])
  @@index([dueAt])
}

model ReminderDelivery {
  id         String    @id @default(cuid())
  collectionId String?
  reminderId String
  userId     String?
  recipient  String
  subject    String
  status     String    @default("PENDING")
  provider   String?
  providerId String?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([reminderId])
  @@index([userId])
  @@index([status])
  @@index([sentAt])
}
