generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GoverningBody {
  collectionId     String?
  id               String            @id @default(cuid())
  name             String
  abbreviation     String?
  website          String?
  notes            String?
  collection       Collection?       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  plantDefinitions PlantDefinition[]

  @@index([collectionId])
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  emailVerifiedAt     DateTime?
  passwordHash        String
  role                String               @default("USER")
  disabledAt          DateTime?
  disabledReason      String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  auditLogs           AuditLog[]
  emailTokens         EmailToken[]
  emailPreference     EmailPreference?
  pushSubscriptions   PushSubscription[]
  sortPreferences     UserSortPreference[]
  reminders           Reminder[]
  follows             Follow[]
  followNotifications FollowNotification[]
  plantCareEvents     PlantCareEvent[]
  plantConditions     PlantCondition[]
  plantCareAdjustments PlantCareAdjustment[]
  twoFactor           UserTwoFactor?
  twoFactorChallenges TwoFactorChallenge[]
  memberships         CollectionMembership[]
  collectionRequests  CollectionRequest[] @relation("CollectionRequestRequester")
  reviewedCollectionRequests CollectionRequest[] @relation("CollectionRequestReviewer")
  aiAccessRequests    AiAccessRequest[] @relation("AiAccessRequestRequester")
  reviewedAiAccessRequests AiAccessRequest[] @relation("AiAccessRequestReviewer")
  aiUsageEvents       AiUsageEvent[]
  archivedCollections Collection[] @relation("CollectionArchivedBy")
  backupRuns          BackupRun[] @relation("BackupRunRequestedBy")
  generatedCollectionBriefings CollectionBriefing[]
  sunshine            Sunshine[]
  sentCollectionInvitations CollectionInvitation[] @relation("CollectionInvitationInviter")
  acceptedCollectionInvitations CollectionInvitation[] @relation("CollectionInvitationAcceptedUser")
  requestedTransferConnections CollectionTransferConnection[] @relation("TransferConnectionRequester")
  respondedTransferConnections CollectionTransferConnection[] @relation("TransferConnectionResponder")
  requestedPlantTransfers PlantTransferRequest[] @relation("PlantTransferRequester")
  reviewedPlantTransfers PlantTransferRequest[] @relation("PlantTransferReviewer")
  requestedDefinitionShares PlantDefinitionShareRequest[] @relation("DefinitionShareRequester")
  reviewedDefinitionShares PlantDefinitionShareRequest[] @relation("DefinitionShareReviewer")
  validatedPlantDefinitions PlantDefinition[] @relation("PlantDefinitionValidatedBy")
  submittedPlantDefinitionValidationCandidates PlantDefinitionValidationCandidate[] @relation("PlantDefinitionValidationCandidateSubmitter")
  reviewedPlantDefinitionValidationCandidates PlantDefinitionValidationCandidate[] @relation("PlantDefinitionValidationCandidateReviewer")
  submittedPlantDefinitionDisputes PlantDefinitionDispute[] @relation("PlantDefinitionDisputeSubmitter")
  reviewedPlantDefinitionDisputes PlantDefinitionDispute[] @relation("PlantDefinitionDisputeReviewer")
  validatedDefinitionChanges ValidatedDefinitionChange[] @relation("ValidatedDefinitionChangeActor")
  collectionUpdateDigestDeliveries CollectionUpdateDigestDelivery[]
  uploadedImageModerationReviews ImageModerationReview[] @relation("ImageModerationReviewUploader")
  resolvedImageModerationReviews ImageModerationReview[] @relation("ImageModerationReviewResolver")
  uploadedPhotos Photo[] @relation("PhotoUploader")
  plantIdentificationLogs PlantIdentificationLog[]
  careSheets          CareSheet[]
  completedCareSheetTasks CareSheetTask[] @relation("CareSheetTaskCompletedBy")

  @@index([role])
  @@index([emailVerifiedAt])
  @@index([disabledAt])
}

model Collection {
  id                  String                 @id @default(cuid())
  name                String
  slug                String                 @unique
  visibility          String                 @default("PRIVATE")
  status              String                 @default("ACTIVE")
  isDefault           Boolean                @default(false)
  aiFeaturesEnabled   Boolean                @default(true)
  aiBriefingEnabled   Boolean                @default(false)
  description         String?
  archivedAt          DateTime?
  archivedById        String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  archivedBy          User?                  @relation("CollectionArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  memberships         CollectionMembership[]
  invitations         CollectionInvitation[]
  collectionRequests  CollectionRequest[]
  aiAccessRequests    AiAccessRequest[]
  aiUsageEvents       AiUsageEvent[]
  briefings           CollectionBriefing[]
  sunshine            Sunshine[]
  auditLogs           AuditLog[]
  follows             Follow[]
  followNotifications FollowNotification[]
  plantDefinitions    PlantDefinition[]
  sourceValidatedPlantDefinitions PlantDefinition[] @relation("ValidatedPlantDefinitionSourceCollection")
  plantDefinitionValidationCandidates PlantDefinitionValidationCandidate[]
  plantDefinitionDisputes PlantDefinitionDispute[]
  plantAliases        PlantAlias[]
  plantInstances      PlantInstance[]
  propagationEvents   PropagationEvent[]
  notes               Note[]
  photos              Photo[]
  imageModerationReviews ImageModerationReview[]
  plantIdentificationLogs PlantIdentificationLog[]
  bloomEvents         BloomEvent[]
  reminders           Reminder[]
  reminderDeliveries  ReminderDelivery[]
  plantCareEvents     PlantCareEvent[]
  plantConditions     PlantCondition[]
  plantCareAdjustments PlantCareAdjustment[]
  governingBodies     GoverningBody[]
  plantHusbandryGuides PlantHusbandryGuide[]
  plantHusbandryOverrides PlantHusbandryOverride[]
  outgoingTransferConnections CollectionTransferConnection[] @relation("TransferConnectionSource")
  incomingTransferConnections CollectionTransferConnection[] @relation("TransferConnectionTarget")
  outgoingPlantTransferRequests PlantTransferRequest[] @relation("PlantTransferSourceCollection")
  incomingPlantTransferRequests PlantTransferRequest[] @relation("PlantTransferTargetCollection")
  outgoingDefinitionShareRequests PlantDefinitionShareRequest[] @relation("DefinitionShareSourceCollection")
  incomingDefinitionShareRequests PlantDefinitionShareRequest[] @relation("DefinitionShareTargetCollection")
  careSheets          CareSheet[]
  careSheetPlants     CareSheetPlant[]
  careSheetTasks      CareSheetTask[]
  careSheetAccessLogs CareSheetAccessLog[]
  collectionUpdateDigestDeliveries CollectionUpdateDigestDelivery[]

  @@index([visibility])
  @@index([status])
  @@index([isDefault])
  @@index([aiFeaturesEnabled])
  @@index([aiBriefingEnabled])
}

model CollectionBriefing {
  id                String    @id @default(cuid())
  collectionId      String
  localDate         String
  timezone          String
  model             String?
  promptVersion     String
  sourceHash        String?
  status            String    @default("READY")
  title             String
  summaryMarkdown   String
  structuredJson    Json?
  generatedAt       DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  generatedByUserId String?

  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  generatedByUser User?      @relation(fields: [generatedByUserId], references: [id], onDelete: SetNull)

  @@unique([collectionId, localDate])
  @@index([collectionId])
  @@index([localDate])
  @@index([status])
  @@index([generatedByUserId])
}

model CollectionMembership {
  id           String   @id @default(cuid())
  collectionId String
  userId       String
  role         String   @default("VIEWER")
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
  @@index([collectionId])
  @@index([userId])
  @@index([role])
  @@index([status])
}

model CollectionInvitation {
  id             String    @id @default(cuid())
  collectionId   String
  email          String
  role           String    @default("VIEWER")
  tokenHash      String    @unique
  status         String    @default("PENDING")
  inviterId      String
  acceptedUserId String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  inviter      User       @relation("CollectionInvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  acceptedUser User?      @relation("CollectionInvitationAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model CollectionTransferConnection {
  id                 String    @id @default(cuid())
  sourceCollectionId String
  targetCollectionId String
  status             String    @default("PENDING")
  requestedById      String
  respondedById      String?
  requestedAt        DateTime  @default(now())
  respondedAt        DateTime?
  requestNote        String?
  responseNote       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sourceCollection Collection @relation("TransferConnectionSource", fields: [sourceCollectionId], references: [id], onDelete: Cascade)
  targetCollection Collection @relation("TransferConnectionTarget", fields: [targetCollectionId], references: [id], onDelete: Cascade)
  requestedBy      User       @relation("TransferConnectionRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  respondedBy      User?      @relation("TransferConnectionResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  transferRequests PlantTransferRequest[]
  definitionShareRequests PlantDefinitionShareRequest[]

  @@unique([sourceCollectionId, targetCollectionId])
  @@index([sourceCollectionId])
  @@index([targetCollectionId])
  @@index([status])
  @@index([requestedAt])
}

model PlantTransferRequest {
  id                    String    @id @default(cuid())
  connectionId          String
  sourceCollectionId    String
  targetCollectionId    String
  sourcePlantInstanceId String
  targetPlantInstanceId String?
  status                String    @default("PENDING")
  requestedById         String
  reviewedById          String?
  requestedAt           DateTime  @default(now())
  reviewedAt            DateTime?
  senderNote            String?
  receiverNote          String?
  previewSnapshot       Json
  transferManifest      Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  connection          CollectionTransferConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sourceCollection    Collection @relation("PlantTransferSourceCollection", fields: [sourceCollectionId], references: [id], onDelete: Cascade)
  targetCollection    Collection @relation("PlantTransferTargetCollection", fields: [targetCollectionId], references: [id], onDelete: Cascade)
  sourcePlantInstance PlantInstance @relation("SourcePlantTransferRequests", fields: [sourcePlantInstanceId], references: [id], onDelete: Cascade)
  targetPlantInstance PlantInstance? @relation("TargetPlantTransferRequests", fields: [targetPlantInstanceId], references: [id], onDelete: SetNull)
  requestedBy         User @relation("PlantTransferRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy          User? @relation("PlantTransferReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([connectionId])
  @@index([sourceCollectionId])
  @@index([targetCollectionId])
  @@index([sourcePlantInstanceId])
  @@index([targetPlantInstanceId])
  @@index([status])
  @@index([requestedAt])
}

model PlantDefinitionShareRequest {
  id                      String    @id @default(cuid())
  connectionId            String
  sourceCollectionId      String
  targetCollectionId      String
  sourcePlantDefinitionId String
  targetPlantDefinitionId String?
  status                  String    @default("PENDING")
  requestedById           String
  reviewedById            String?
  requestedAt             DateTime  @default(now())
  reviewedAt              DateTime?
  senderNote              String?
  receiverNote            String?
  previewSnapshot         Json
  transferManifest        Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  connection            CollectionTransferConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sourceCollection      Collection @relation("DefinitionShareSourceCollection", fields: [sourceCollectionId], references: [id], onDelete: Cascade)
  targetCollection      Collection @relation("DefinitionShareTargetCollection", fields: [targetCollectionId], references: [id], onDelete: Cascade)
  sourcePlantDefinition PlantDefinition @relation("SourceDefinitionShareRequests", fields: [sourcePlantDefinitionId], references: [id], onDelete: Cascade)
  targetPlantDefinition PlantDefinition? @relation("TargetDefinitionShareRequests", fields: [targetPlantDefinitionId], references: [id], onDelete: SetNull)
  requestedBy           User @relation("DefinitionShareRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy            User? @relation("DefinitionShareReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([connectionId])
  @@index([sourceCollectionId])
  @@index([targetCollectionId])
  @@index([sourcePlantDefinitionId])
  @@index([targetPlantDefinitionId])
  @@index([status])
  @@index([requestedAt])
}

model CollectionRequest {
  id             String    @id @default(cuid())
  requestedById  String
  reviewedById   String?
  collectionId   String?
  requestedName  String
  requestedSlug  String
  visibility     String    @default("PRIVATE")
  description    String?
  rationale      String?
  status         String    @default("PENDING")
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  requestedBy User        @relation("CollectionRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("CollectionRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  collection  Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@index([requestedById])
  @@index([reviewedById])
  @@index([collectionId])
  @@index([requestedSlug])
  @@index([status])
  @@index([createdAt])
}

model AiAccessRequest {
  id             String    @id @default(cuid())
  collectionId   String
  requestedById  String
  reviewedById   String?
  status         String    @default("PENDING")
  rationale      String?
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  collection  Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("AiAccessRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User?      @relation("AiAccessRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
  @@index([createdAt])
}

model AiUsageEvent {
  id           String   @id @default(cuid())
  collectionId String
  userId       String?
  feature      String
  model        String?
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  success      Boolean  @default(true)
  error        String?
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([userId])
  @@index([feature])
  @@index([success])
  @@index([createdAt])
}

model ServerMetricSnapshot {
  id        String   @id @default(cuid())
  capturedAt DateTime @default(now())
  metrics   Json

  @@index([capturedAt])
}

model BackupRun {
  id            String    @id @default(cuid())
  scope         String    @default("SITEWIDE")
  status        String    @default("REQUESTED")
  requestedById String?
  requestedAt   DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  backupPath    String?
  manifest      Json?
  log           String?
  error         String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  requestedBy User? @relation("BackupRunRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([scope])
  @@index([status])
  @@index([requestedAt])
  @@index([requestedById])
}

model Session {
  id                  String    @id @default(cuid())
  tokenHash           String    @unique
  userId              String
  expiresAt           DateTime
  twoFactorVerifiedAt DateTime?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserTwoFactor {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  secretCiphertext         String
  recoveryCodesCiphertext  String?
  recoveryCodesGeneratedAt DateTime?
  recoveryCodesViewedAt    DateTime?
  enabledAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes TwoFactorRecoveryCode[]
}

model TwoFactorChallenge {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
}

model TwoFactorRecoveryCode {
  id              String    @id @default(cuid())
  userTwoFactorId String
  codeHash        String
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  userTwoFactor UserTwoFactor @relation(fields: [userTwoFactorId], references: [id], onDelete: Cascade)

  @@unique([userTwoFactorId, codeHash])
  @@index([userTwoFactorId])
  @@index([usedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  collectionId String?
  userId     String?
  userEmail  String?
  userRole   String?
  action     String
  entityType String
  entityId   String?
  summary    String?
  metadata   String?
  createdAt  DateTime @default(now())

  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model EmailToken {
  id           String    @id @default(cuid())
  userId       String?
  email        String
  purpose      String
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  consumedByIp String?
  createdAt    DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([purpose])
  @@index([expiresAt])
  @@index([usedAt])
}

model EmailPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  timezone              String   @default("America/New_York")
  authSecurityEmails    Boolean  @default(true)
  welcomeEmails         Boolean  @default(true)
  generalReminders      Boolean  @default(true)
  plantCheckInReminders Boolean  @default(true)
  bloomCycleReminders   Boolean  @default(true)
  propagationFollowUps  Boolean  @default(true)
  followNotifications   Boolean  @default(true)
  transferNotifications Boolean  @default(true)
  sunshineNotifications Boolean  @default(false)
  collectionUpdateDigestEmailEnabled Boolean @default(true)
  careQueueDigestEmailEnabled Boolean @default(true)
  serverHealthEmailEnabled Boolean @default(true)
  generalRemindersPushEnabled Boolean @default(false)
  plantCheckInRemindersPushEnabled Boolean @default(false)
  bloomCycleRemindersPushEnabled Boolean @default(false)
  propagationFollowUpsPushEnabled Boolean @default(false)
  followNotificationsPushEnabled Boolean @default(false)
  sunshineNotificationsPushEnabled Boolean @default(false)
  collectionUpdateDigestPushEnabled Boolean @default(false)
  careQueueDigestPushEnabled Boolean @default(false)
  serverHealthPushEnabled Boolean @default(false)
  careQueueDigestSendTime String @default("08:00")
  careQueueDigestLastSentAt DateTime?
  serverHealthAlertLastSentAt DateTime?
  sunshineNotificationLastSentAt DateTime?
  quietHoursStart       String?
  quietHoursEnd         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sunshine {
  id           String   @id @default(cuid())
  collectionId String
  userId       String
  targetType   String
  targetId     String
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId, targetType, targetId])
  @@index([collectionId, targetType, targetId])
  @@index([userId])
  @@index([createdAt])
}

model PushSubscription {
  id           String    @id @default(cuid())
  userId       String
  endpoint     String    @unique
  p256dh       String
  auth         String
  userAgent    String?
  deviceLabel  String?
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastSeenAt   DateTime?
  revokedAt    DateTime?
  failureCount Int       @default(0)
  lastFailureAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
  @@index([revokedAt])
  @@index([lastSeenAt])
}

model UserSortPreference {
  id        String   @id @default(cuid())
  userId    String
  section   String
  sortKey   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, section])
  @@index([userId])
  @@index([section])
}

model Follow {
  id         String   @id @default(cuid())
  collectionId String?
  userId     String
  scope      String
  entityType String
  entityId   String
  label      String
  createdAt  DateTime @default(now())

  collection    Collection?           @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications FollowNotification[]

  @@unique([collectionId, userId, scope, entityType, entityId])
  @@index([collectionId])
  @@index([userId])
  @@index([scope, entityType, entityId])
}

model FollowNotification {
  id        String    @id @default(cuid())
  collectionId String?
  followId  String
  userId    String
  eventType String
  subject   String
  body      String?
  recordUrl String
  status    String    @default("PENDING")
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  follow Follow @relation(fields: [followId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([followId])
  @@index([userId])
  @@index([eventType])
  @@index([status])
  @@index([sentAt])
}

model PlantDefinition {
  id                         String   @id @default(cuid())
  collectionId               String?
  genus                      String
  species                    String
  hybridNotation             String?
  cultivarName               String?
  authority                  String?
  cultivarRegistrationNumber String?
  governingBodyId            String?
  confidence                 String   @default("UNCERTAIN")
  acquisitionLabel           String?
  provisionalTaxon           String?
  wikipediaUrl               String?
  inaturalistUrl             String?
  powoUrl                    String?
  gbifUrl                    String?
  description                String?
  notes                      String?
  isValidated                Boolean  @default(false)
  validatedAt                DateTime?
  validatedByUserId          String?
  validatedSourceCollectionId String?
  validatedSourceDefinitionId String?
  validatedPlantDefinitionId String?
  validationNotes            String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  collection    Collection?      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  governingBody GoverningBody?  @relation(fields: [governingBodyId], references: [id], onDelete: SetNull)
  validatedBy   User?           @relation("PlantDefinitionValidatedBy", fields: [validatedByUserId], references: [id], onDelete: SetNull)
  validatedSourceCollection Collection? @relation("ValidatedPlantDefinitionSourceCollection", fields: [validatedSourceCollectionId], references: [id], onDelete: SetNull)
  validatedPlantDefinition PlantDefinition? @relation("LocalValidatedDefinitionLink", fields: [validatedPlantDefinitionId], references: [id], onDelete: SetNull)
  localLinkedDefinitions PlantDefinition[] @relation("LocalValidatedDefinitionLink")
  instances     PlantInstance[]
  aliases       PlantAlias[]
  husbandryGuide PlantHusbandryGuide?
  husbandrySourceFor PlantHusbandryGuide[] @relation("HusbandrySourceDefinition")
  outgoingDefinitionShareRequests PlantDefinitionShareRequest[] @relation("SourceDefinitionShareRequests")
  incomingDefinitionShareRequests PlantDefinitionShareRequest[] @relation("TargetDefinitionShareRequests")
  validationCandidates PlantDefinitionValidationCandidate[] @relation("ValidationCandidateSourceDefinition")
  approvedValidationCandidates PlantDefinitionValidationCandidate[] @relation("ValidationCandidateApprovedDefinition")
  disputes PlantDefinitionDispute[] @relation("ValidatedDefinitionDisputes")
  validatedChanges ValidatedDefinitionChange[]
  matchedIdentificationLogs PlantIdentificationLog[] @relation("PlantIdentificationLogMatchedDefinition")
  appliedIdentificationLogs PlantIdentificationLog[] @relation("PlantIdentificationLogAppliedDefinition")
  createdIdentificationLogs PlantIdentificationLog[] @relation("PlantIdentificationLogCreatedDefinition")

  @@index([collectionId])
  @@index([governingBodyId])
  @@index([confidence])
  @@index([isValidated])
  @@index([validatedByUserId])
  @@index([validatedSourceCollectionId])
  @@index([validatedSourceDefinitionId])
  @@index([validatedPlantDefinitionId])
}

model ValidatedDefinitionChange {
  id                    String   @id @default(cuid())
  validatedDefinitionId String
  changedByUserId       String?
  changedAt             DateTime @default(now())
  changeSummary         String
  changedFieldsJson     Json
  previousValuesJson    Json?
  nextValuesJson        Json?
  createdAt             DateTime @default(now())

  validatedDefinition PlantDefinition @relation(fields: [validatedDefinitionId], references: [id], onDelete: Cascade)
  changedByUser       User?           @relation("ValidatedDefinitionChangeActor", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([validatedDefinitionId])
  @@index([changedByUserId])
