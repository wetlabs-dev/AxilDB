}

model PlantDefinitionValidationCandidate {
  id                         String   @id @default(cuid())
  collectionId               String
  plantDefinitionId          String?
  nominatedByUserId          String?
  notes                      String?
  status                     String   @default("PENDING")
  reviewedByUserId           String?
