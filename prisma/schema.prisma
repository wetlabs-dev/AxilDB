generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServerIncidentCategory {
  MEMORY
  DISK
  WORKER
  EMAIL
  AI
  NETWORK
  MANUAL
}

enum ServerIncidentSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ServerIncidentStatus {
  OPEN
  RESOLVED
}

enum RestoreRequestStatus {
  PLANNED
  VALIDATED
  COMMAND_GENERATED
  COMPLETED_EXTERNALLY
  CANCELLED
}

enum CollectionExhibitAccessMode {
  PUBLIC
  UNLISTED
}

enum CollectionExhibitStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  EXPIRED
}

enum CollectionExhibitSubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

enum CollectionExhibitUpdateDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

model GoverningBody {
  collectionId     String?
  id               String            @id @default(cuid())
  name             String
  abbreviation     String?
  website          String?
  notes            String?
  collection       Collection?       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  plantDefinitions PlantDefinition[]

  @@index([collectionId])
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  emailVerifiedAt     DateTime?
  passwordHash        String
  role                String               @default("USER")
  disabledAt          DateTime?
  disabledReason      String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  auditLogs           AuditLog[]
  emailTokens         EmailToken[]
  emailPreference     EmailPreference?
  pushSubscriptions   PushSubscription[]
  sortPreferences     UserSortPreference[]
  reminders           Reminder[]
  follows             Follow[]
  followNotifications FollowNotification[]
  plantCareEvents     PlantCareEvent[]
  plantConditions     PlantCondition[]
  plantCareAdjustments PlantCareAdjustment[]
  twoFactor           UserTwoFactor?
  twoFactorChallenges TwoFactorChallenge[]
  memberships         CollectionMembership[]
  collectionRequests  CollectionRequest[] @relation("CollectionRequestRequester")
  reviewedCollectionRequests CollectionRequest[] @relation("CollectionRequestReviewer")
  aiAccessRequests    AiAccessRequest[] @relation("AiAccessRequestRequester")
  reviewedAiAccessRequests AiAccessRequest[] @relation("AiAccessRequestReviewer")
  aiUsageEvents       AiUsageEvent[]
  archivedCollections Collection[] @relation("CollectionArchivedBy")
  backupRuns          BackupRun[] @relation("BackupRunRequestedBy")
  maintenanceStarted  MaintenanceMode[] @relation("MaintenanceModeStartedBy")
  maintenanceEnded    MaintenanceMode[] @relation("MaintenanceModeEndedBy")
  requestedRestoreRequests RestoreRequest[] @relation("RestoreRequestRequestedBy")
  completedRestoreRequests RestoreRequest[] @relation("RestoreRequestCompletedBy")
  cancelledRestoreRequests RestoreRequest[] @relation("RestoreRequestCancelledBy")
  generatedCollectionBriefings CollectionBriefing[]
  sunshine            Sunshine[]
  sentCollectionInvitations CollectionInvitation[] @relation("CollectionInvitationInviter")
  acceptedCollectionInvitations CollectionInvitation[] @relation("CollectionInvitationAcceptedUser")
  requestedTransferConnections CollectionTransferConnection[] @relation("TransferConnectionRequester")
  respondedTransferConnections CollectionTransferConnection[] @relation("TransferConnectionResponder")
  requestedPlantTransfers PlantTransferRequest[] @relation("PlantTransferRequester")
  reviewedPlantTransfers PlantTransferRequest[] @relation("PlantTransferReviewer")
  requestedDefinitionShares PlantDefinitionShareRequest[] @relation("DefinitionShareRequester")
  reviewedDefinitionShares PlantDefinitionShareRequest[] @relation("DefinitionShareReviewer")
  validatedPlantDefinitions PlantDefinition[] @relation("PlantDefinitionValidatedBy")
  submittedPlantDefinitionValidationCandidates PlantDefinitionValidationCandidate[] @relation("PlantDefinitionValidationCandidateSubmitter")
  reviewedPlantDefinitionValidationCandidates PlantDefinitionValidationCandidate[] @relation("PlantDefinitionValidationCandidateReviewer")
  submittedPlantDefinitionDisputes PlantDefinitionDispute[] @relation("PlantDefinitionDisputeSubmitter")
  reviewedPlantDefinitionDisputes PlantDefinitionDispute[] @relation("PlantDefinitionDisputeReviewer")
  validatedDefinitionChanges ValidatedDefinitionChange[] @relation("ValidatedDefinitionChangeActor")
  collectionUpdateDigestDeliveries CollectionUpdateDigestDelivery[]
  uploadedImageModerationReviews ImageModerationReview[] @relation("ImageModerationReviewUploader")
  resolvedImageModerationReviews ImageModerationReview[] @relation("ImageModerationReviewResolver")
  uploadedPhotos Photo[] @relation("PhotoUploader")
  plantIdentificationLogs PlantIdentificationLog[]
  plantLocationMoves PlantLocationMove[]
  createdServerIncidents ServerIncident[] @relation("ServerIncidentCreator")
  serverIncidentNotes ServerIncidentNote[] @relation("ServerIncidentNoteAuthor")
  serverIncidentNotifications ServerIncidentNotification[]
  createdPlantQuarantines PlantQuarantine[] @relation("PlantQuarantineCreatedBy")
  releasedPlantQuarantines PlantQuarantine[] @relation("PlantQuarantineReleasedBy")
  cancelledPlantQuarantines PlantQuarantine[] @relation("PlantQuarantineCancelledBy")
  careSheets          CareSheet[]
  completedCareSheetTasks CareSheetTask[] @relation("CareSheetTaskCompletedBy")
  domainEvents        DomainEvent[] @relation("DomainEventActor")
  ignoredDomainEvents DomainEvent[] @relation("DomainEventIgnoredBy")
  createdCollectionExhibits CollectionExhibit[] @relation("CollectionExhibitCreatedBy")
  publishedCollectionExhibits CollectionExhibit[] @relation("CollectionExhibitPublishedBy")
  createdCollectionExhibitUpdates CollectionExhibitUpdate[] @relation("CollectionExhibitUpdateCreatedBy")
  createdWorkflowTemplates WorkflowTemplate[] @relation("WorkflowTemplateCreatedBy")
  startedWorkflowRuns WorkflowRun[] @relation("WorkflowRunStartedBy")
  assignedWorkflowRuns WorkflowRun[] @relation("WorkflowRunAssignedTo")
  completedWorkflowRunSteps WorkflowRunStep[] @relation("WorkflowRunStepCompletedBy")
  createdCareScheduleSyncBatches CareScheduleSyncBatch[] @relation("CareScheduleSyncBatchCreatedBy")
  createdQuietDays CollectionQuietDay[] @relation("CollectionQuietDayCreatedBy")

  @@index([role])
  @@index([emailVerifiedAt])
  @@index([disabledAt])
}

model Collection {
  id                  String                 @id @default(cuid())
  name                String
  slug                String                 @unique
  visibility          String                 @default("PRIVATE")
  status              String                 @default("ACTIVE")
  isDefault           Boolean                @default(false)
  aiFeaturesEnabled   Boolean                @default(true)
  aiBriefingEnabled   Boolean                @default(false)
  description         String?
  archivedAt          DateTime?
  archivedById        String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  archivedBy          User?                  @relation("CollectionArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  memberships         CollectionMembership[]
  invitations         CollectionInvitation[]
  collectionRequests  CollectionRequest[]
  aiAccessRequests    AiAccessRequest[]
  aiUsageEvents       AiUsageEvent[]
  briefings           CollectionBriefing[]
  sunshine            Sunshine[]
  auditLogs           AuditLog[]
  follows             Follow[]
  followNotifications FollowNotification[]
  plantDefinitions    PlantDefinition[]
  sourceValidatedPlantDefinitions PlantDefinition[] @relation("ValidatedPlantDefinitionSourceCollection")
  plantDefinitionValidationCandidates PlantDefinitionValidationCandidate[]
  plantDefinitionDisputes PlantDefinitionDispute[]
  plantAliases        PlantAlias[]
  plantInstances      PlantInstance[]
  locationTypes       LocationType[]
  locations           Location[]
  plantLocationMoves  PlantLocationMove[]
  plantQuarantines    PlantQuarantine[]
  propagationEvents   PropagationEvent[]
  notes               Note[]
  photos              Photo[]
  imageModerationReviews ImageModerationReview[]
  plantIdentificationLogs PlantIdentificationLog[]
  bloomEvents         BloomEvent[]
  reminders           Reminder[]
  reminderDeliveries  ReminderDelivery[]
  plantCareEvents     PlantCareEvent[]
  plantConditions     PlantCondition[]
  plantCareAdjustments PlantCareAdjustment[]
  careScheduleSyncBatches CareScheduleSyncBatch[]
  careScheduleSyncItems CareScheduleSyncItem[]
  quietDays           CollectionQuietDay[]
  quietDayShiftRules  CollectionQuietDayShiftRule[]
  quietDayAdjustments CareQuietDayAdjustment[]
  governingBodies     GoverningBody[]
  plantHusbandryGuides PlantHusbandryGuide[]
  plantHusbandryOverrides PlantHusbandryOverride[]
  fertilizerProducts  FertilizerProduct[]
  fertilizerRecipes   FertilizerRecipe[]
  outgoingTransferConnections CollectionTransferConnection[] @relation("TransferConnectionSource")
  incomingTransferConnections CollectionTransferConnection[] @relation("TransferConnectionTarget")
  outgoingPlantTransferRequests PlantTransferRequest[] @relation("PlantTransferSourceCollection")
  incomingPlantTransferRequests PlantTransferRequest[] @relation("PlantTransferTargetCollection")
  outgoingDefinitionShareRequests PlantDefinitionShareRequest[] @relation("DefinitionShareSourceCollection")
  incomingDefinitionShareRequests PlantDefinitionShareRequest[] @relation("DefinitionShareTargetCollection")
  careSheets          CareSheet[]
  careSheetPlants     CareSheetPlant[]
  careSheetTasks      CareSheetTask[]
  careSheetAccessLogs CareSheetAccessLog[]
  collectionUpdateDigestDeliveries CollectionUpdateDigestDelivery[]
  exhibits            CollectionExhibit[]
  workflowTemplates   WorkflowTemplate[]
  workflowRuns        WorkflowRun[]
  workflowRunPlants   WorkflowRunPlant[]
  workflowRunSteps    WorkflowRunStep[]
  domainEvents        DomainEvent[]

  @@index([visibility])
  @@index([status])
  @@index([isDefault])
  @@index([aiFeaturesEnabled])
  @@index([aiBriefingEnabled])
}

model CollectionBriefing {
  id                String    @id @default(cuid())
  collectionId      String
  localDate         String
  timezone          String
  model             String?
  promptVersion     String
  sourceHash        String?
  status            String    @default("READY")
  title             String
  summaryMarkdown   String
  structuredJson    Json?
  generatedAt       DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  generatedByUserId String?

  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  generatedByUser User?      @relation(fields: [generatedByUserId], references: [id], onDelete: SetNull)

  @@unique([collectionId, localDate])
  @@index([collectionId])
  @@index([localDate])
  @@index([status])
  @@index([generatedByUserId])
}

model CollectionMembership {
  id           String   @id @default(cuid())
  collectionId String
  userId       String
  role         String   @default("VIEWER")
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
  @@index([collectionId])
  @@index([userId])
  @@index([role])
  @@index([status])
}

model CollectionInvitation {
  id             String    @id @default(cuid())
  collectionId   String
  email          String
  role           String    @default("VIEWER")
  tokenHash      String    @unique
  status         String    @default("PENDING")
  inviterId      String
  acceptedUserId String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  inviter      User       @relation("CollectionInvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  acceptedUser User?      @relation("CollectionInvitationAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model CollectionTransferConnection {
  id                 String    @id @default(cuid())
  sourceCollectionId String
  targetCollectionId String
  status             String    @default("PENDING")
  requestedById      String
  respondedById      String?
  requestedAt        DateTime  @default(now())
  respondedAt        DateTime?
  requestNote        String?
  responseNote       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sourceCollection Collection @relation("TransferConnectionSource", fields: [sourceCollectionId], references: [id], onDelete: Cascade)
  targetCollection Collection @relation("TransferConnectionTarget", fields: [targetCollectionId], references: [id], onDelete: Cascade)
  requestedBy      User       @relation("TransferConnectionRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  respondedBy      User?      @relation("TransferConnectionResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  transferRequests PlantTransferRequest[]
  definitionShareRequests PlantDefinitionShareRequest[]

  @@unique([sourceCollectionId, targetCollectionId])
  @@index([sourceCollectionId])
  @@index([targetCollectionId])
  @@index([status])
  @@index([requestedAt])
}

model PlantTransferRequest {
  id                    String    @id @default(cuid())
  connectionId          String
  sourceCollectionId    String
  targetCollectionId    String
  sourcePlantInstanceId String
  targetPlantInstanceId String?
  status                String    @default("PENDING")
  requestedById         String
  reviewedById          String?
  requestedAt           DateTime  @default(now())
  reviewedAt            DateTime?
  senderNote            String?
  receiverNote          String?
  previewSnapshot       Json
  transferManifest      Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  connection          CollectionTransferConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sourceCollection    Collection @relation("PlantTransferSourceCollection", fields: [sourceCollectionId], references: [id], onDelete: Cascade)
  targetCollection    Collection @relation("PlantTransferTargetCollection", fields: [targetCollectionId], references: [id], onDelete: Cascade)
  sourcePlantInstance PlantInstance @relation("SourcePlantTransferRequests", fields: [sourcePlantInstanceId], references: [id], onDelete: Cascade)
  targetPlantInstance PlantInstance? @relation("TargetPlantTransferRequests", fields: [targetPlantInstanceId], references: [id], onDelete: SetNull)
  requestedBy         User @relation("PlantTransferRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy          User? @relation("PlantTransferReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([connectionId])
  @@index([sourceCollectionId])
  @@index([targetCollectionId])
  @@index([sourcePlantInstanceId])
  @@index([targetPlantInstanceId])
  @@index([status])
  @@index([requestedAt])
}

model PlantDefinitionShareRequest {
  id                      String    @id @default(cuid())
  connectionId            String
  sourceCollectionId      String
  targetCollectionId      String
  sourcePlantDefinitionId String
  targetPlantDefinitionId String?
  status                  String    @default("PENDING")
  requestedById           String
  reviewedById            String?
  requestedAt             DateTime  @default(now())
  reviewedAt              DateTime?
  senderNote              String?
  receiverNote            String?
  previewSnapshot         Json
  transferManifest        Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  connection            CollectionTransferConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sourceCollection      Collection @relation("DefinitionShareSourceCollection", fields: [sourceCollectionId], references: [id], onDelete: Cascade)
  targetCollection      Collection @relation("DefinitionShareTargetCollection", fields: [targetCollectionId], references: [id], onDelete: Cascade)
  sourcePlantDefinition PlantDefinition @relation("SourceDefinitionShareRequests", fields: [sourcePlantDefinitionId], references: [id], onDelete: Cascade)
  targetPlantDefinition PlantDefinition? @relation("TargetDefinitionShareRequests", fields: [targetPlantDefinitionId], references: [id], onDelete: SetNull)
  requestedBy           User @relation("DefinitionShareRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy            User? @relation("DefinitionShareReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([connectionId])
  @@index([sourceCollectionId])
  @@index([targetCollectionId])
  @@index([sourcePlantDefinitionId])
  @@index([targetPlantDefinitionId])
  @@index([status])
  @@index([requestedAt])
}

model CollectionRequest {
  id             String    @id @default(cuid())
  requestedById  String
  reviewedById   String?
  collectionId   String?
  requestedName  String
  requestedSlug  String
  visibility     String    @default("PRIVATE")
  description    String?
  rationale      String?
  status         String    @default("PENDING")
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  requestedBy User        @relation("CollectionRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("CollectionRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  collection  Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@index([requestedById])
  @@index([reviewedById])
  @@index([collectionId])
  @@index([requestedSlug])
  @@index([status])
  @@index([createdAt])
}

model AiAccessRequest {
  id             String    @id @default(cuid())
  collectionId   String
  requestedById  String
  reviewedById   String?
  status         String    @default("PENDING")
  rationale      String?
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  collection  Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("AiAccessRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User?      @relation("AiAccessRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
  @@index([createdAt])
}

model AiUsageEvent {
  id           String   @id @default(cuid())
  collectionId String
  userId       String?
  feature      String
  model        String?
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  success      Boolean  @default(true)
  error        String?
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([userId])
  @@index([feature])
  @@index([success])
  @@index([createdAt])
}

model ServerMetricSnapshot {
  id        String   @id @default(cuid())
  capturedAt DateTime @default(now())
  metrics   Json

  @@index([capturedAt])
}

model ServerIncident {
  id              String    @id @default(cuid())
  type            String
  category        ServerIncidentCategory
  severity        ServerIncidentSeverity
  status          ServerIncidentStatus @default(OPEN)
  title           String
  description     String?
  detectedAt      DateTime
  resolvedAt      DateTime?
  durationSeconds Int?
  metricType      String?
  thresholdValue  Float?
  observedValue   Float?
  peakValue       Float?
  createdByUserId String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdBy     User? @relation("ServerIncidentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  notes         ServerIncidentNote[]
  notifications ServerIncidentNotification[]

  @@index([type])
  @@index([category])
  @@index([severity])
  @@index([status])
  @@index([metricType])
  @@index([detectedAt])
  @@index([resolvedAt])
  @@index([createdByUserId])
}

model ServerIncidentNote {
  id          String   @id @default(cuid())
  incidentId  String
  authorUserId String?
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  incident ServerIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User? @relation("ServerIncidentNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([incidentId])
  @@index([authorUserId])
  @@index([createdAt])
}

model ServerIncidentNotification {
  id          String   @id @default(cuid())
  incidentId  String
  userId      String?
  channel     String
  status      String
  recipient   String?
  sentAt      DateTime @default(now())
  metadata    Json?

  incident ServerIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([incidentId])
  @@index([userId])
  @@index([sentAt])
  @@index([status])
}

model ServerWorkerRun {
  id          String    @id @default(cuid())
  workerName  String
  status      String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  durationMs  Int?
  summary     String?
  error       String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([workerName])
  @@index([status])
  @@index([startedAt])
}

model DomainEvent {
  id                  String    @id @default(cuid())
  eventType           String
  eventVersion        Int       @default(1)
  collectionId        String?
  aggregateType       String
  aggregateId         String
  actorUserId         String?
  actorRole           String?
  source              String    @default("APPLICATION")
  visibility          String
  occurredAt          DateTime
  recordedAt          DateTime  @default(now())
  payloadJson         Json
  summaryJson         Json?
  metadataJson        Json?
  idempotencyKey      String    @unique
  correlationId       String?
  causationId         String?
  reconstructed       Boolean   @default(false)
  redactedAt          DateTime?
  supersededByEventId String?
  processingStatus    String    @default("PENDING")
  processingAttempts  Int       @default(0)
  nextAttemptAt       DateTime?
  lastProcessingError String?
  processedAt         DateTime?
  ignoredAt           DateTime?
  ignoredByUserId     String?
  ignoreReason        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  collection        Collection?                    @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  actor             User?                          @relation("DomainEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  ignoredBy         User?                          @relation("DomainEventIgnoredBy", fields: [ignoredByUserId], references: [id], onDelete: SetNull)
  supersededByEvent DomainEvent?                   @relation("DomainEventSupersession", fields: [supersededByEventId], references: [id], onDelete: SetNull)
  supersedes        DomainEvent[]                  @relation("DomainEventSupersession")
  processingHistory DomainEventProcessingAttempt[]

  @@index([collectionId, occurredAt])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([processingStatus, nextAttemptAt])
  @@index([actorUserId, occurredAt])
  @@index([correlationId])
  @@index([occurredAt])
}

model DomainEventProcessingAttempt {
  id           String    @id @default(cuid())
  eventId      String
  attempt      Int
  status       String
  consumer     String?
  error        String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  metadataJson Json?

  event DomainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, startedAt])
  @@index([status, startedAt])
}

model BackupRun {
  id            String    @id @default(cuid())
  scope         String    @default("SITEWIDE")
  status        String    @default("REQUESTED")
  requestedById String?
  requestedAt   DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  backupPath    String?
  manifest      Json?
  log           String?
  error         String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  requestedBy User? @relation("BackupRunRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([scope])
  @@index([status])
  @@index([requestedAt])
  @@index([requestedById])
}

model CollectionExhibit {
  id                 String                      @id @default(cuid())
  collectionId       String
  title              String
  slug               String                      @unique
  token              String?                     @unique
  accessMode         CollectionExhibitAccessMode @default(UNLISTED)
  status             CollectionExhibitStatus     @default(DRAFT)
  description        String?
  introMarkdown      String?
  coverPhotoId       String?
  createdByUserId    String?
  publishedByUserId  String?
  publishedAt        DateTime?
  expiresAt          DateTime?
  revokedAt          DateTime?
  settingsJson       Json?
  updateSettingsJson Json?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  collection  Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  coverPhoto  Photo?     @relation("CollectionExhibitCoverPhoto", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  createdBy   User?      @relation("CollectionExhibitCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  publishedBy User?      @relation("CollectionExhibitPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  plants      CollectionExhibitPlant[]
  subscribers CollectionExhibitSubscriber[]
  updates     CollectionExhibitUpdate[]

  @@index([collectionId])
  @@index([status])
  @@index([accessMode])
  @@index([expiresAt])
  @@index([createdByUserId])
  @@index([publishedByUserId])
}

model CollectionExhibitPlant {
  id              String   @id @default(cuid())
  exhibitId       String
  plantInstanceId String
  sortOrder       Int      @default(0)
  featured        Boolean  @default(false)
  customCaption   String?
  createdAt       DateTime @default(now())

  exhibit       CollectionExhibit @relation(fields: [exhibitId], references: [id], onDelete: Cascade)
  plantInstance PlantInstance     @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)

  @@unique([exhibitId, plantInstanceId])
  @@index([exhibitId])
  @@index([plantInstanceId])
  @@index([sortOrder])
}

model CollectionExhibitSubscriber {
  id                   String                            @id @default(cuid())
  exhibitId            String
  email                String
  status               CollectionExhibitSubscriberStatus @default(PENDING)
  confirmTokenHash     String?                           @unique
  unsubscribeTokenHash String                            @unique
  confirmedAt          DateTime?
  unsubscribedAt       DateTime?
  createdAt            DateTime                          @default(now())
  updatedAt            DateTime                          @updatedAt

  exhibit    CollectionExhibit @relation(fields: [exhibitId], references: [id], onDelete: Cascade)
  deliveries CollectionExhibitDelivery[]

  @@unique([exhibitId, email])
  @@index([exhibitId])
  @@index([email])
  @@index([status])
}

model CollectionExhibitUpdate {
  id                String    @id @default(cuid())
  exhibitId         String
  title             String
  summary           String?
  changeSummaryJson Json?
  createdByUserId   String?
  createdAt         DateTime  @default(now())
  sentAt            DateTime?

  exhibit    CollectionExhibit @relation(fields: [exhibitId], references: [id], onDelete: Cascade)
  createdBy  User?             @relation("CollectionExhibitUpdateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  deliveries CollectionExhibitDelivery[]

  @@index([exhibitId])
  @@index([createdAt])
  @@index([sentAt])
  @@index([createdByUserId])
}

model CollectionExhibitDelivery {
  id              String                                @id @default(cuid())
  exhibitUpdateId String
  subscriberId    String
  status          CollectionExhibitUpdateDeliveryStatus @default(SKIPPED)
  error           String?
  sentAt          DateTime?
  createdAt       DateTime                              @default(now())

  exhibitUpdate CollectionExhibitUpdate     @relation(fields: [exhibitUpdateId], references: [id], onDelete: Cascade)
  subscriber    CollectionExhibitSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([exhibitUpdateId])
  @@index([subscriberId])
  @@index([status])
}

model MaintenanceMode {
  id                  String    @id @default(cuid())
  enabled             Boolean   @default(false)
  message             String?
  expectedReturnAt    DateTime?
  startedAt           DateTime?
  startedByUserId     String?
  endedAt             DateTime?
