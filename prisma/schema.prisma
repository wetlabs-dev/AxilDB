generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GoverningBody {
  collectionId     String?
  id               String            @id @default(cuid())
  name             String
  abbreviation     String?
  website          String?
  notes            String?
  collection       Collection?       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  plantDefinitions PlantDefinition[]

  @@index([collectionId])
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  emailVerifiedAt     DateTime?
  passwordHash        String
  role                String               @default("USER")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  auditLogs           AuditLog[]
  emailTokens         EmailToken[]
  emailPreference     EmailPreference?
  reminders           Reminder[]
  follows             Follow[]
  followNotifications FollowNotification[]
  twoFactor           UserTwoFactor?
  twoFactorChallenges TwoFactorChallenge[]
  memberships         CollectionMembership[]
  collectionRequests  CollectionRequest[] @relation("CollectionRequestRequester")
  reviewedCollectionRequests CollectionRequest[] @relation("CollectionRequestReviewer")
  archivedCollections Collection[] @relation("CollectionArchivedBy")
  backupRuns          BackupRun[] @relation("BackupRunRequestedBy")
  sentCollectionInvitations CollectionInvitation[] @relation("CollectionInvitationInviter")
  acceptedCollectionInvitations CollectionInvitation[] @relation("CollectionInvitationAcceptedUser")

  @@index([role])
  @@index([emailVerifiedAt])
}

model Collection {
  id                  String                 @id @default(cuid())
  name                String
  slug                String                 @unique
  visibility          String                 @default("PRIVATE")
  status              String                 @default("ACTIVE")
  isDefault           Boolean                @default(false)
  description         String?
  archivedAt          DateTime?
  archivedById        String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  archivedBy          User?                  @relation("CollectionArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  memberships         CollectionMembership[]
  invitations         CollectionInvitation[]
  collectionRequests  CollectionRequest[]
  auditLogs           AuditLog[]
  follows             Follow[]
  followNotifications FollowNotification[]
  plantDefinitions    PlantDefinition[]
  plantAliases        PlantAlias[]
  plantInstances      PlantInstance[]
  propagationEvents   PropagationEvent[]
  notes               Note[]
  photos              Photo[]
  bloomEvents         BloomEvent[]
  reminders           Reminder[]
  reminderDeliveries  ReminderDelivery[]
  governingBodies     GoverningBody[]

  @@index([visibility])
  @@index([status])
  @@index([isDefault])
}

model CollectionMembership {
  id           String   @id @default(cuid())
  collectionId String
  userId       String
  role         String   @default("VIEWER")
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
  @@index([collectionId])
  @@index([userId])
  @@index([role])
  @@index([status])
}

model CollectionInvitation {
  id             String    @id @default(cuid())
  collectionId   String
  email          String
  role           String    @default("VIEWER")
  tokenHash      String    @unique
  status         String    @default("PENDING")
  inviterId      String
  acceptedUserId String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  inviter      User       @relation("CollectionInvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  acceptedUser User?      @relation("CollectionInvitationAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model CollectionRequest {
  id             String    @id @default(cuid())
  requestedById  String
  reviewedById   String?
  collectionId   String?
  requestedName  String
  requestedSlug  String
  visibility     String    @default("PRIVATE")
  description    String?
  rationale      String?
  status         String    @default("PENDING")
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  requestedBy User        @relation("CollectionRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("CollectionRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  collection  Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@index([requestedById])
  @@index([reviewedById])
  @@index([collectionId])
  @@index([requestedSlug])
  @@index([status])
  @@index([createdAt])
}

model ServerMetricSnapshot {
  id        String   @id @default(cuid())
  capturedAt DateTime @default(now())
  metrics   Json

  @@index([capturedAt])
}

model BackupRun {
  id            String    @id @default(cuid())
  scope         String    @default("SITEWIDE")
  status        String    @default("REQUESTED")
  requestedById String?
  requestedAt   DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  backupPath    String?
  manifest      Json?
  log           String?
  error         String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  requestedBy User? @relation("BackupRunRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([scope])
  @@index([status])
  @@index([requestedAt])
  @@index([requestedById])
}

model Session {
  id                  String    @id @default(cuid())
  tokenHash           String    @unique
  userId              String
  expiresAt           DateTime
  twoFactorVerifiedAt DateTime?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserTwoFactor {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  secretCiphertext         String
  recoveryCodesCiphertext  String?
  recoveryCodesGeneratedAt DateTime?
  recoveryCodesViewedAt    DateTime?
  enabledAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes TwoFactorRecoveryCode[]
}

model TwoFactorChallenge {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
}

model TwoFactorRecoveryCode {
  id              String    @id @default(cuid())
  userTwoFactorId String
  codeHash        String
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  userTwoFactor UserTwoFactor @relation(fields: [userTwoFactorId], references: [id], onDelete: Cascade)

  @@unique([userTwoFactorId, codeHash])
  @@index([userTwoFactorId])
  @@index([usedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  collectionId String?
  userId     String?
  userEmail  String?
  userRole   String?
  action     String
  entityType String
  entityId   String?
  summary    String?
  metadata   String?
  createdAt  DateTime @default(now())

  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model EmailToken {
  id           String    @id @default(cuid())
  userId       String?
  email        String
  purpose      String
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  consumedByIp String?
  createdAt    DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([purpose])
  @@index([expiresAt])
  @@index([usedAt])
}

model EmailPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  timezone              String   @default("America/New_York")
  authSecurityEmails    Boolean  @default(true)
  welcomeEmails         Boolean  @default(true)
  generalReminders      Boolean  @default(true)
  plantCheckInReminders Boolean  @default(true)
  bloomCycleReminders   Boolean  @default(true)
  propagationFollowUps  Boolean  @default(true)
  followNotifications   Boolean  @default(true)
  quietHoursStart       String?
  quietHoursEnd         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follow {
  id         String   @id @default(cuid())
  collectionId String?
  userId     String
  scope      String
  entityType String
  entityId   String
  label      String
  createdAt  DateTime @default(now())

  collection    Collection?           @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications FollowNotification[]

  @@unique([collectionId, userId, scope, entityType, entityId])
  @@index([collectionId])
  @@index([userId])
  @@index([scope, entityType, entityId])
}

model FollowNotification {
  id        String    @id @default(cuid())
  collectionId String?
  followId  String
  userId    String
  eventType String
  subject   String
  body      String?
  recordUrl String
  status    String    @default("PENDING")
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  follow Follow @relation(fields: [followId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([followId])
  @@index([userId])
  @@index([eventType])
  @@index([status])
  @@index([sentAt])
}

model PlantDefinition {
  id                         String   @id @default(cuid())
  collectionId               String?
  genus                      String
  species                    String
  hybridNotation             String?
  cultivarName               String?
  authority                  String?
  cultivarRegistrationNumber String?
  governingBodyId            String?
  confidence                 String   @default("UNCERTAIN")
  acquisitionLabel           String?
  provisionalTaxon           String?
  wikipediaUrl               String?
  inaturalistUrl             String?
  powoUrl                    String?
  gbifUrl                    String?
  description                String?
  notes                      String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  collection    Collection?      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  governingBody GoverningBody?  @relation(fields: [governingBodyId], references: [id], onDelete: SetNull)
  instances     PlantInstance[]
  aliases       PlantAlias[]

  @@index([collectionId])
  @@index([governingBodyId])
  @@index([confidence])
}

model PlantAlias {
  id                String   @id @default(cuid())
  collectionId      String?
  plantDefinitionId String
  name              String
  aliasType         String   @default("SYNONYM")
  source            String?
  confidence        String   @default("UNCERTAIN")
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  collection      Collection?      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  plantDefinition PlantDefinition @relation(fields: [plantDefinitionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([plantDefinitionId])
  @@index([aliasType])
  @@index([confidence])
}

model PlantInstance {
  id                String    @id @default(cuid())
  collectionId      String?
  plantDefinitionId String
  plantId           String
  instanceType      String
  status            String    @default("ACTIVE")
  location          String?
  acquisitionDate   DateTime?
  propagationDate   DateTime?
  source            String?
  distributor       String?
  stockNumber       String?
  purchasePrice     Decimal?
  archiveDate       DateTime?
  archiveReason     String?
  archiveNotes      String?
  isSportCandidate  Boolean   @default(false)
  sportStatus       String    @default("NONE")
  sportDescription  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  collection      Collection?              @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  plantDefinition PlantDefinition        @relation(fields: [plantDefinitionId], references: [id], onDelete: Cascade)
  parentLinks     ParentageLink[]
  childLinks      PropagationChild[]
  blooms          BloomEvent[]
  sportRecords    SportStabilityRecord[]

  @@index([collectionId])
  @@unique([collectionId, plantId])
  @@index([plantDefinitionId])
  @@index([status])
  @@index([instanceType])
  @@index([sportStatus])
}

model PropagationEvent {
  id            String   @id @default(cuid())
  collectionId  String?
  method        String
  date          DateTime
  notes         String?
  successStatus String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  collection   Collection?            @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  parents      ParentageLink[]
  children     PropagationChild[]
  sportRecords SportStabilityRecord[]

  @@index([collectionId])
  @@index([date])
  @@index([method])
  @@index([successStatus])
}

model ParentageLink {
  id                    String @id @default(cuid())
  propagationEventId    String
  parentPlantInstanceId String
  parentRole            String

  propagationEvent    PropagationEvent @relation(fields: [propagationEventId], references: [id], onDelete: Cascade)
  parentPlantInstance PlantInstance    @relation(fields: [parentPlantInstanceId], references: [id], onDelete: Cascade)

  @@index([propagationEventId])
  @@index([parentPlantInstanceId])
}

model PropagationChild {
  id                   String @id @default(cuid())
  propagationEventId   String
  childPlantInstanceId String

  propagationEvent   PropagationEvent @relation(fields: [propagationEventId], references: [id], onDelete: Cascade)
  childPlantInstance PlantInstance    @relation(fields: [childPlantInstanceId], references: [id], onDelete: Cascade)

  @@index([propagationEventId])
  @@index([childPlantInstanceId])
}

model Note {
  id         String   @id @default(cuid())
  collectionId String?
  entityType String
  entityId   String
  note       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([entityType, entityId])
}

model Photo {
  id         String   @id @default(cuid())
  collectionId String?
  entityType String
  entityId   String
  filename   String
  path       String
  caption    String?
  source     String?
  sourceUrl  String?
  isCover    Boolean  @default(false)
  isType     Boolean  @default(false)
  createdAt  DateTime @default(now())

  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([entityType, entityId])
  @@index([isCover])
  @@index([isType])
}

model BloomEvent {
  id              String    @id @default(cuid())
  collectionId    String?
  plantInstanceId String
  bloomStartDate  DateTime
  peakBloomDate   DateTime?
  bloomEndDate    DateTime?
  flowerCount     Int?
  firstBloom      Boolean   @default(false)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  collection    Collection?    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  plantInstance PlantInstance @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([plantInstanceId])
}

model SportStabilityRecord {
  id                 String   @id @default(cuid())
  plantInstanceId    String
  propagationEventId String
  propagatedTrue     Boolean
  generationNumber   Int
  notes              String?
  createdAt          DateTime @default(now())

  plantInstance    PlantInstance    @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)
  propagationEvent PropagationEvent @relation(fields: [propagationEventId], references: [id], onDelete: Cascade)

  @@index([plantInstanceId])
  @@index([propagationEventId])
}

model Reminder {
  id          String    @id @default(cuid())
  collectionId String?
  userId      String
  title       String
  body        String?
  category    String    @default("GENERAL")
  entityType  String?
  entityId    String?
  dueAt       DateTime
  rrule       String?
  lastSentAt  DateTime?
  nextSendAt  DateTime?
  completedAt DateTime?
  pausedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  collection Collection?        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries ReminderDelivery[]

  @@index([collectionId])
  @@index([userId])
  @@index([category])
  @@index([entityType, entityId])
  @@index([nextSendAt])
  @@index([dueAt])
}

model ReminderDelivery {
  id         String    @id @default(cuid())
  collectionId String?
  reminderId String
  userId     String?
  recipient  String
  subject    String
  status     String    @default("PENDING")
  provider   String?
  providerId String?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([reminderId])
  @@index([userId])
  @@index([status])
  @@index([sentAt])
}
