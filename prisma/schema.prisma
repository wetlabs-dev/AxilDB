  updatedAt           DateTime  @updatedAt

  startedBy User? @relation("MaintenanceModeStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)
  endedBy   User? @relation("MaintenanceModeEndedBy", fields: [endedByUserId], references: [id], onDelete: SetNull)

  @@index([enabled])
  @@index([startedByUserId])
  @@index([endedByUserId])
}

model RestoreRequest {
  id                  String               @id @default(cuid())
  backupPath          String
  backupName          String
  status              RestoreRequestStatus @default(PLANNED)
  requestedByUserId   String?
  requestedAt         DateTime             @default(now())
  validationJson      Json?
  generatedCommand    String?
  commandGeneratedAt  DateTime?
  notes               String?
  completedAt         DateTime?
