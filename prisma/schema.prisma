  completedBy User? @relation("RestoreRequestCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  cancelledBy User? @relation("RestoreRequestCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  @@index([backupPath])
  @@index([status])
  @@index([requestedAt])
  @@index([requestedByUserId])
}

model Session {
  id                  String    @id @default(cuid())
  tokenHash           String    @unique
  userId              String
  expiresAt           DateTime
  twoFactorVerifiedAt DateTime?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserTwoFactor {
