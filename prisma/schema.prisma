model TwoFactorChallenge {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
}

model TwoFactorRecoveryCode {
  id              String    @id @default(cuid())
  userTwoFactorId String
  codeHash        String
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  userTwoFactor UserTwoFactor @relation(fields: [userTwoFactorId], references: [id], onDelete: Cascade)

  @@unique([userTwoFactorId, codeHash])
