generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GoverningBody {
  collectionId     String?
  id               String            @id @default(cuid())
  name             String
  abbreviation     String?
  website          String?
  notes            String?
  collection       Collection?       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  plantDefinitions PlantDefinition[]

  @@index([collectionId])
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  emailVerifiedAt     DateTime?
  passwordHash        String
  role                String               @default("USER")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  auditLogs           AuditLog[]
  emailTokens         EmailToken[]
  emailPreference     EmailPreference?
  sortPreferences     UserSortPreference[]
  reminders           Reminder[]
  follows             Follow[]
  followNotifications FollowNotification[]
  plantCareEvents     PlantCareEvent[]
  plantConditions     PlantCondition[]
  plantCareAdjustments PlantCareAdjustment[]
  twoFactor           UserTwoFactor?
  twoFactorChallenges TwoFactorChallenge[]
  memberships         CollectionMembership[]
  collectionRequests  CollectionRequest[] @relation("CollectionRequestRequester")
  reviewedCollectionRequests CollectionRequest[] @relation("CollectionRequestReviewer")
  aiAccessRequests    AiAccessRequest[] @relation("AiAccessRequestRequester")
  reviewedAiAccessRequests AiAccessRequest[] @relation("AiAccessRequestReviewer")
  aiUsageEvents       AiUsageEvent[]
  archivedCollections Collection[] @relation("CollectionArchivedBy")
  backupRuns          BackupRun[] @relation("BackupRunRequestedBy")
  sentCollectionInvitations CollectionInvitation[] @relation("CollectionInvitationInviter")
  acceptedCollectionInvitations CollectionInvitation[] @relation("CollectionInvitationAcceptedUser")
  requestedTransferConnections CollectionTransferConnection[] @relation("TransferConnectionRequester")
  respondedTransferConnections CollectionTransferConnection[] @relation("TransferConnectionResponder")
  requestedPlantTransfers PlantTransferRequest[] @relation("PlantTransferRequester")
  reviewedPlantTransfers PlantTransferRequest[] @relation("PlantTransferReviewer")
  requestedDefinitionShares PlantDefinitionShareRequest[] @relation("DefinitionShareRequester")
  reviewedDefinitionShares PlantDefinitionShareRequest[] @relation("DefinitionShareReviewer")

  @@index([role])
  @@index([emailVerifiedAt])
}

model Collection {
  id                  String                 @id @default(cuid())
  name                String
  slug                String                 @unique
  visibility          String                 @default("PRIVATE")
  status              String                 @default("ACTIVE")
  isDefault           Boolean                @default(false)
  aiFeaturesEnabled   Boolean                @default(true)
  description         String?
  archivedAt          DateTime?
  archivedById        String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  archivedBy          User?                  @relation("CollectionArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  memberships         CollectionMembership[]
  invitations         CollectionInvitation[]
  collectionRequests  CollectionRequest[]
  aiAccessRequests    AiAccessRequest[]
  aiUsageEvents       AiUsageEvent[]
  auditLogs           AuditLog[]
  follows             Follow[]
  followNotifications FollowNotification[]
  plantDefinitions    PlantDefinition[]
  plantAliases        PlantAlias[]
  plantInstances      PlantInstance[]
  propagationEvents   PropagationEvent[]
  notes               Note[]
  photos              Photo[]
  bloomEvents         BloomEvent[]
  reminders           Reminder[]
  reminderDeliveries  ReminderDelivery[]
  plantCareEvents     PlantCareEvent[]
  plantConditions     PlantCondition[]
  plantCareAdjustments PlantCareAdjustment[]
  governingBodies     GoverningBody[]
  plantHusbandryGuides PlantHusbandryGuide[]
  plantHusbandryOverrides PlantHusbandryOverride[]
  outgoingTransferConnections CollectionTransferConnection[] @relation("TransferConnectionSource")
  incomingTransferConnections CollectionTransferConnection[] @relation("TransferConnectionTarget")
  outgoingPlantTransferRequests PlantTransferRequest[] @relation("PlantTransferSourceCollection")
  incomingPlantTransferRequests PlantTransferRequest[] @relation("PlantTransferTargetCollection")
  outgoingDefinitionShareRequests PlantDefinitionShareRequest[] @relation("DefinitionShareSourceCollection")
  incomingDefinitionShareRequests PlantDefinitionShareRequest[] @relation("DefinitionShareTargetCollection")

  @@index([visibility])
  @@index([status])
  @@index([isDefault])
  @@index([aiFeaturesEnabled])
}

model CollectionMembership {
  id           String   @id @default(cuid())
  collectionId String
  userId       String
  role         String   @default("VIEWER")
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
  @@index([collectionId])
  @@index([userId])
  @@index([role])
  @@index([status])
}

model CollectionInvitation {
  id             String    @id @default(cuid())
  collectionId   String
  email          String
  role           String    @default("VIEWER")
  tokenHash      String    @unique
  status         String    @default("PENDING")
  inviterId      String
  acceptedUserId String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  inviter      User       @relation("CollectionInvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  acceptedUser User?      @relation("CollectionInvitationAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model CollectionTransferConnection {
  id                 String    @id @default(cuid())
  sourceCollectionId String
  targetCollectionId String
  status             String    @default("PENDING")
  requestedById      String
  respondedById      String?
  requestedAt        DateTime  @default(now())
  respondedAt        DateTime?
  requestNote        String?
  responseNote       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sourceCollection Collection @relation("TransferConnectionSource", fields: [sourceCollectionId], references: [id], onDelete: Cascade)
  targetCollection Collection @relation("TransferConnectionTarget", fields: [targetCollectionId], references: [id], onDelete: Cascade)
  requestedBy      User       @relation("TransferConnectionRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  respondedBy      User?      @relation("TransferConnectionResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  transferRequests PlantTransferRequest[]
  definitionShareRequests PlantDefinitionShareRequest[]

  @@unique([sourceCollectionId, targetCollectionId])
  @@index([sourceCollectionId])
  @@index([targetCollectionId])
  @@index([status])
  @@index([requestedAt])
}

model PlantTransferRequest {
  id                    String    @id @default(cuid())
  connectionId          String
  sourceCollectionId    String
  targetCollectionId    String
  sourcePlantInstanceId String
  targetPlantInstanceId String?
  status                String    @default("PENDING")
  requestedById         String
  reviewedById          String?
  requestedAt           DateTime  @default(now())
  reviewedAt            DateTime?
  senderNote            String?
  receiverNote          String?
  previewSnapshot       Json
  transferManifest      Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  connection          CollectionTransferConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sourceCollection    Collection @relation("PlantTransferSourceCollection", fields: [sourceCollectionId], references: [id], onDelete: Cascade)
  targetCollection    Collection @relation("PlantTransferTargetCollection", fields: [targetCollectionId], references: [id], onDelete: Cascade)
  sourcePlantInstance PlantInstance @relation("SourcePlantTransferRequests", fields: [sourcePlantInstanceId], references: [id], onDelete: Cascade)
  targetPlantInstance PlantInstance? @relation("TargetPlantTransferRequests", fields: [targetPlantInstanceId], references: [id], onDelete: SetNull)
  requestedBy         User @relation("PlantTransferRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy          User? @relation("PlantTransferReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([connectionId])
  @@index([sourceCollectionId])
  @@index([targetCollectionId])
  @@index([sourcePlantInstanceId])
  @@index([targetPlantInstanceId])
  @@index([status])
  @@index([requestedAt])
}

model PlantDefinitionShareRequest {
  id                      String    @id @default(cuid())
  connectionId            String
  sourceCollectionId      String
  targetCollectionId      String
  sourcePlantDefinitionId String
  targetPlantDefinitionId String?
  status                  String    @default("PENDING")
  requestedById           String
  reviewedById            String?
  requestedAt             DateTime  @default(now())
  reviewedAt              DateTime?
  senderNote              String?
  receiverNote            String?
  previewSnapshot         Json
  transferManifest        Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  connection            CollectionTransferConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sourceCollection      Collection @relation("DefinitionShareSourceCollection", fields: [sourceCollectionId], references: [id], onDelete: Cascade)
  targetCollection      Collection @relation("DefinitionShareTargetCollection", fields: [targetCollectionId], references: [id], onDelete: Cascade)
  sourcePlantDefinition PlantDefinition @relation("SourceDefinitionShareRequests", fields: [sourcePlantDefinitionId], references: [id], onDelete: Cascade)
  targetPlantDefinition PlantDefinition? @relation("TargetDefinitionShareRequests", fields: [targetPlantDefinitionId], references: [id], onDelete: SetNull)
  requestedBy           User @relation("DefinitionShareRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy            User? @relation("DefinitionShareReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([connectionId])
  @@index([sourceCollectionId])
  @@index([targetCollectionId])
  @@index([sourcePlantDefinitionId])
  @@index([targetPlantDefinitionId])
  @@index([status])
  @@index([requestedAt])
}

model CollectionRequest {
  id             String    @id @default(cuid())
  requestedById  String
  reviewedById   String?
  collectionId   String?
  requestedName  String
  requestedSlug  String
  visibility     String    @default("PRIVATE")
  description    String?
  rationale      String?
  status         String    @default("PENDING")
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  requestedBy User        @relation("CollectionRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("CollectionRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  collection  Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@index([requestedById])
  @@index([reviewedById])
  @@index([collectionId])
  @@index([requestedSlug])
  @@index([status])
  @@index([createdAt])
}

model AiAccessRequest {
  id             String    @id @default(cuid())
  collectionId   String
  requestedById  String
  reviewedById   String?
  status         String    @default("PENDING")
  rationale      String?
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  collection  Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("AiAccessRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User?      @relation("AiAccessRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
  @@index([createdAt])
}

model AiUsageEvent {
  id           String   @id @default(cuid())
  collectionId String
  userId       String?
  feature      String
  model        String?
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  success      Boolean  @default(true)
  error        String?
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([userId])
  @@index([feature])
  @@index([success])
  @@index([createdAt])
}

model ServerMetricSnapshot {
  id        String   @id @default(cuid())
  capturedAt DateTime @default(now())
  metrics   Json

  @@index([capturedAt])
}

model BackupRun {
  id            String    @id @default(cuid())
  scope         String    @default("SITEWIDE")
  status        String    @default("REQUESTED")
  requestedById String?
  requestedAt   DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  backupPath    String?
  manifest      Json?
  log           String?
  error         String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  requestedBy User? @relation("BackupRunRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([scope])
  @@index([status])
  @@index([requestedAt])
  @@index([requestedById])
}

model Session {
  id                  String    @id @default(cuid())
  tokenHash           String    @unique
  userId              String
  expiresAt           DateTime
  twoFactorVerifiedAt DateTime?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserTwoFactor {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  secretCiphertext         String
  recoveryCodesCiphertext  String?
  recoveryCodesGeneratedAt DateTime?
  recoveryCodesViewedAt    DateTime?
  enabledAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes TwoFactorRecoveryCode[]
}

model TwoFactorChallenge {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
}

model TwoFactorRecoveryCode {
  id              String    @id @default(cuid())
  userTwoFactorId String
  codeHash        String
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  userTwoFactor UserTwoFactor @relation(fields: [userTwoFactorId], references: [id], onDelete: Cascade)

  @@unique([userTwoFactorId, codeHash])
  @@index([userTwoFactorId])
  @@index([usedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  collectionId String?
  userId     String?
  userEmail  String?
  userRole   String?
  action     String
  entityType String
  entityId   String?
  summary    String?
  metadata   String?
  createdAt  DateTime @default(now())

  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model EmailToken {
  id           String    @id @default(cuid())
  userId       String?
  email        String
  purpose      String
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  consumedByIp String?
  createdAt    DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([purpose])
  @@index([expiresAt])
  @@index([usedAt])
}

model EmailPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  timezone              String   @default("America/New_York")
  authSecurityEmails    Boolean  @default(true)
  welcomeEmails         Boolean  @default(true)
  generalReminders      Boolean  @default(true)
  plantCheckInReminders Boolean  @default(true)
  bloomCycleReminders   Boolean  @default(true)
  propagationFollowUps  Boolean  @default(true)
  followNotifications   Boolean  @default(true)
  transferNotifications Boolean  @default(true)
  quietHoursStart       String?
  quietHoursEnd         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSortPreference {
  id        String   @id @default(cuid())
  userId    String
  section   String
  sortKey   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, section])
  @@index([userId])
  @@index([section])
}

model Follow {
  id         String   @id @default(cuid())
  collectionId String?
  userId     String
  scope      String
  entityType String
  entityId   String
  label      String
  createdAt  DateTime @default(now())

  collection    Collection?           @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications FollowNotification[]

  @@unique([collectionId, userId, scope, entityType, entityId])
  @@index([collectionId])
  @@index([userId])
  @@index([scope, entityType, entityId])
}

model FollowNotification {
  id        String    @id @default(cuid())
  collectionId String?
  followId  String
  userId    String
  eventType String
  subject   String
  body      String?
  recordUrl String
  status    String    @default("PENDING")
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  follow Follow @relation(fields: [followId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([followId])
  @@index([userId])
  @@index([eventType])
  @@index([status])
  @@index([sentAt])
}

model PlantDefinition {
  id                         String   @id @default(cuid())
  collectionId               String?
  genus                      String
  species                    String
  hybridNotation             String?
  cultivarName               String?
  authority                  String?
  cultivarRegistrationNumber String?
  governingBodyId            String?
  confidence                 String   @default("UNCERTAIN")
  acquisitionLabel           String?
  provisionalTaxon           String?
  wikipediaUrl               String?
  inaturalistUrl             String?
  powoUrl                    String?
  gbifUrl                    String?
  description                String?
  notes                      String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  collection    Collection?      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  governingBody GoverningBody?  @relation(fields: [governingBodyId], references: [id], onDelete: SetNull)
  instances     PlantInstance[]
  aliases       PlantAlias[]
  husbandryGuide PlantHusbandryGuide?
  husbandrySourceFor PlantHusbandryGuide[] @relation("HusbandrySourceDefinition")
  outgoingDefinitionShareRequests PlantDefinitionShareRequest[] @relation("SourceDefinitionShareRequests")
  incomingDefinitionShareRequests PlantDefinitionShareRequest[] @relation("TargetDefinitionShareRequests")

  @@index([collectionId])
  @@index([governingBodyId])
  @@index([confidence])
}

model PlantHusbandryGuide {
  id                      String    @id @default(cuid())
  collectionId            String?
  plantDefinitionId       String    @unique
  sourcePlantDefinitionId String?
  summaryWater            String?
  summaryLight            String?
  summaryToxicity         String?
  summaryCare             String?
  wateringCadence         String?
  wateringMoistureLevel   String?
  wateringDroughtTolerance String?
  wateringCycleNotes      String?
  wateringSeasonalAdjustments String?
  lightIntensity          String?
  lightDuration           String?
  temperatureUsdaZone     String?
  temperatureColdTolerance String?
  temperatureHeatTolerance String?
  temperatureFrostSensitivity String?
  temperatureOverwinterInstructions String?
  humidityRange           String?
  humidityDryAirTolerance String?
  humidityMistingNotes    String?
  mediumPreferred         String?
  mediumPh                String?
  mediumDrainage          String?
  mediumHabit             String?
  mediumRecipeNotes       String?
  fertilizationType       String?
  fertilizationStrength   String?
  fertilizationFrequency  String?
  fertilizationSeasonalSchedule String?
  fertilizationMicronutrientNotes String?
  repottingInterval       String?
  repottingPotType        String?
  repottingRootSensitivity String?
  repottingDormancyConsideration String?
  repottingDivisionGuidance String?
  propagationMethods      String?
  propagationDifficulty   String?
  propagationExpectedSuccess String?
  propagationOptimalTiming String?
  propagationRootingHormoneNotes String?
  propagationTissueCultureNotes String?
  pestsCommon             String?
  diseasesCommon          String?
  treatmentNotes          String?
  susceptibilityLevel     String?
  preventativePractices   String?
  toxicityPets            String?
  toxicityHumans          String?
  toxicitySapIrritant     String?
  toxicityEdible          String?
  dormancyBehavior        String?
  bloomSeason             String?
  bloomDuration           String?
  bloomFragrance          String?
  bloomRebloomTendency    String?
  bloomTriggers           String?
  bloomPollinatorNotes    String?
  growthHabit             String?
  rarity                  String?
  conservationStatus      String?
  conservationLinks       String?
  protectedSpeciesNotes   String?
  collectionRestrictions  String?
  importExportConcerns    String?
  invasiveness            String?
  nativeRangeNotes        String?
  aiGeneratedAt           DateTime?
  aiModel                 String?
  reviewStatus            String    @default("DRAFT")
  reviewNotes             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  collection            Collection?      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  plantDefinition       PlantDefinition @relation(fields: [plantDefinitionId], references: [id], onDelete: Cascade)
  sourcePlantDefinition PlantDefinition? @relation("HusbandrySourceDefinition", fields: [sourcePlantDefinitionId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([plantDefinitionId])
  @@index([sourcePlantDefinitionId])
  @@index([reviewStatus])
}

model PlantAlias {
  id                String   @id @default(cuid())
  collectionId      String?
  plantDefinitionId String
  name              String
  aliasType         String   @default("SYNONYM")
  source            String?
  confidence        String   @default("UNCERTAIN")
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  collection      Collection?      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  plantDefinition PlantDefinition @relation(fields: [plantDefinitionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([plantDefinitionId])
  @@index([aliasType])
  @@index([confidence])
}

model PlantInstance {
  id                String    @id @default(cuid())
  collectionId      String?
  plantDefinitionId String
  plantId           String
  instanceType      String
  status            String    @default("ACTIVE")
  location          String?
  acquisitionDate   DateTime?
  propagationDate   DateTime?
  source            String?
  distributor       String?
  stockNumber       String?
  purchasePrice     Decimal?
  archiveDate       DateTime?
  archiveReason     String?
  archiveNotes      String?
  originCollectionSlug String?
  originPlantId     String?
  transferredFromCollectionSlug String?
  transferredFromPlantId String?
  isSportCandidate  Boolean   @default(false)
  sportStatus       String    @default("NONE")
  sportDescription  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  collection      Collection?              @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  plantDefinition PlantDefinition        @relation(fields: [plantDefinitionId], references: [id], onDelete: Cascade)
  parentLinks     ParentageLink[]
  childLinks      PropagationChild[]
  blooms          BloomEvent[]
  sportRecords    SportStabilityRecord[]
  husbandryOverride PlantHusbandryOverride?
  careEvents      PlantCareEvent[]
  conditions      PlantCondition[]
  careAdjustments PlantCareAdjustment[]
  outgoingTransferRequests PlantTransferRequest[] @relation("SourcePlantTransferRequests")
  incomingTransferRequests PlantTransferRequest[] @relation("TargetPlantTransferRequests")

  @@index([collectionId])
  @@unique([collectionId, plantId])
  @@index([plantDefinitionId])
  @@index([status])
  @@index([instanceType])
  @@index([sportStatus])
  @@index([originCollectionSlug, originPlantId])
  @@index([transferredFromCollectionSlug, transferredFromPlantId])
}

model PlantHusbandryOverride {
  id                      String    @id @default(cuid())
  collectionId            String?
  plantInstanceId         String    @unique
  summaryWater            String?
  summaryLight            String?
  summaryToxicity         String?
  summaryCare             String?
  wateringCadence         String?
  wateringMoistureLevel   String?
  wateringDroughtTolerance String?
  wateringCycleNotes      String?
  wateringSeasonalAdjustments String?
  lightIntensity          String?
  lightDuration           String?
  temperatureUsdaZone     String?
  temperatureColdTolerance String?
  temperatureHeatTolerance String?
  temperatureFrostSensitivity String?
  temperatureOverwinterInstructions String?
  humidityRange           String?
  humidityDryAirTolerance String?
  humidityMistingNotes    String?
  mediumPreferred         String?
  mediumPh                String?
  mediumDrainage          String?
  mediumHabit             String?
  mediumRecipeNotes       String?
  fertilizationType       String?
  fertilizationStrength   String?
  fertilizationFrequency  String?
  fertilizationSeasonalSchedule String?
  fertilizationMicronutrientNotes String?
  repottingInterval       String?
  repottingPotType        String?
  repottingRootSensitivity String?
  repottingDormancyConsideration String?
  repottingDivisionGuidance String?
  propagationMethods      String?
  propagationDifficulty   String?
  propagationExpectedSuccess String?
  propagationOptimalTiming String?
  propagationRootingHormoneNotes String?
  propagationTissueCultureNotes String?
  pestsCommon             String?
  diseasesCommon          String?
  treatmentNotes          String?
  susceptibilityLevel     String?
  preventativePractices   String?
  toxicityPets            String?
  toxicityHumans          String?
  toxicitySapIrritant     String?
  toxicityEdible          String?
  dormancyBehavior        String?
  bloomSeason             String?
  bloomDuration           String?
  bloomFragrance          String?
  bloomRebloomTendency    String?
  bloomTriggers           String?
  bloomPollinatorNotes    String?
  growthHabit             String?
  rarity                  String?
  conservationStatus      String?
  conservationLinks       String?
  protectedSpeciesNotes   String?
  collectionRestrictions  String?
  importExportConcerns    String?
  invasiveness            String?
  nativeRangeNotes        String?
  overrideNotes           String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  collection    Collection?    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  plantInstance PlantInstance @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([plantInstanceId])
}

model PlantCareEvent {
  id              String   @id @default(cuid())
  collectionId    String?
  plantInstanceId String
  userId          String?
  eventType       String
  performedAt     DateTime @default(now())
  notes           String?
  metadata        Json?
  createdAt       DateTime @default(now())

  collection    Collection?    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  plantInstance PlantInstance @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([plantInstanceId])
  @@index([userId])
  @@index([eventType])
  @@index([performedAt])
}

model PlantCondition {
  id              String    @id @default(cuid())
  collectionId    String?
  plantInstanceId String
  userId          String?
  category        String
  severity        String    @default("MODERATE")
  status          String    @default("OPEN")
  observedAt      DateTime  @default(now())
  resolvedAt      DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  collection    Collection?    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  plantInstance PlantInstance @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([plantInstanceId])
  @@index([userId])
  @@index([category])
  @@index([severity])
  @@index([status])
  @@index([observedAt])
}

model PlantCareAdjustment {
  id                  String    @id @default(cuid())
  collectionId        String?
  plantInstanceId     String
  userId              String?
  taskType            String
  cadenceOverrideDays Int?
  snoozedUntil        DateTime?
  disabled            Boolean   @default(false)
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  collection    Collection?    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  plantInstance PlantInstance @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([collectionId, plantInstanceId, taskType])
  @@index([collectionId])
  @@index([plantInstanceId])
  @@index([userId])
  @@index([taskType])
  @@index([snoozedUntil])
  @@index([disabled])
}

model PropagationEvent {
  id            String   @id @default(cuid())
  collectionId  String?
  method        String
  date          DateTime
  notes         String?
  successStatus String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  collection   Collection?            @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  parents      ParentageLink[]
  children     PropagationChild[]
  sportRecords SportStabilityRecord[]

  @@index([collectionId])
  @@index([date])
  @@index([method])
  @@index([successStatus])
}

model ParentageLink {
  id                    String @id @default(cuid())
  propagationEventId    String
  parentPlantInstanceId String
  parentRole            String

  propagationEvent    PropagationEvent @relation(fields: [propagationEventId], references: [id], onDelete: Cascade)
  parentPlantInstance PlantInstance    @relation(fields: [parentPlantInstanceId], references: [id], onDelete: Cascade)

  @@index([propagationEventId])
  @@index([parentPlantInstanceId])
}

model PropagationChild {
  id                   String @id @default(cuid())
  propagationEventId   String
  childPlantInstanceId String

  propagationEvent   PropagationEvent @relation(fields: [propagationEventId], references: [id], onDelete: Cascade)
  childPlantInstance PlantInstance    @relation(fields: [childPlantInstanceId], references: [id], onDelete: Cascade)

  @@index([propagationEventId])
  @@index([childPlantInstanceId])
}

model Note {
  id         String   @id @default(cuid())
  collectionId String?
  entityType String
  entityId   String
  note       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([entityType, entityId])
}

model Photo {
  id         String   @id @default(cuid())
  collectionId String?
  entityType String
  entityId   String
  filename   String
  path       String
  caption    String?
  source     String?
  sourceUrl  String?
  isCover    Boolean  @default(false)
  isType     Boolean  @default(false)
  createdAt  DateTime @default(now())

  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([entityType, entityId])
  @@index([isCover])
  @@index([isType])
}

model BloomEvent {
  id              String    @id @default(cuid())
  collectionId    String?
  plantInstanceId String
  bloomStartDate  DateTime
  peakBloomDate   DateTime?
  bloomEndDate    DateTime?
  flowerCount     Int?
  firstBloom      Boolean   @default(false)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  collection    Collection?    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  plantInstance PlantInstance @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([plantInstanceId])
}

model SportStabilityRecord {
  id                 String   @id @default(cuid())
  plantInstanceId    String
  propagationEventId String
  propagatedTrue     Boolean
  generationNumber   Int
  notes              String?
  createdAt          DateTime @default(now())

  plantInstance    PlantInstance    @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)
  propagationEvent PropagationEvent @relation(fields: [propagationEventId], references: [id], onDelete: Cascade)

  @@index([plantInstanceId])
  @@index([propagationEventId])
}

model Reminder {
  id          String    @id @default(cuid())
  collectionId String?
  userId      String
  title       String
  body        String?
  category    String    @default("GENERAL")
  entityType  String?
  entityId    String?
  dueAt       DateTime
  rrule       String?
  lastSentAt  DateTime?
  nextSendAt  DateTime?
  completedAt DateTime?
  pausedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  collection Collection?        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries ReminderDelivery[]

  @@index([collectionId])
  @@index([userId])
  @@index([category])
  @@index([entityType, entityId])
  @@index([nextSendAt])
  @@index([dueAt])
}

model ReminderDelivery {
  id         String    @id @default(cuid())
  collectionId String?
  reminderId String
  userId     String?
  recipient  String
  subject    String
  status     String    @default("PENDING")
  provider   String?
  providerId String?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([reminderId])
  @@index([userId])
  @@index([status])
  @@index([sentAt])
}
