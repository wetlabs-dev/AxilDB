    "lucide-react": "^0.468.0",
    "next": "^15.0.3",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
