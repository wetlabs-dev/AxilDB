    "backup": "sh scripts/backup.sh",
    "backup:worker": "tsx scripts/run-backup-worker.ts",
    "docs:manual": "tsx scripts/generate-user-manual.ts",
    "docs:screenshots": "tsx scripts/generate-manual-screenshots.ts",
    "docs:build": "npm run docs:manual && npm run docs:screenshots",
    "check:collection-defaults": "node scripts/check-collection-defaults.mjs",
    "check:collection-scope": "node scripts/check-collection-scope.mjs",
    "check:collection-integrity": "prisma generate && tsx scripts/check-collection-integrity.ts",
    "check:mobile-overflow": "node scripts/check-mobile-overflow.mjs",
